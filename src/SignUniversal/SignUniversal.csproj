<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SignUniversal</RootNamespace>
    <Title>SignUniversal</Title>
    <Description>Cross-platform Authenticode signing for Windows PE binaries and MSI packages, from Linux, macOS or Windows. The private-key operation goes through IRemoteSigner, so the key can stay in an HSM and never reach the process. Add SignUniversal.Azure for Trusted Signing or Key Vault key sources, or SignUniversal.NuGet to sign .nupkg files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- So tests can reach helpers that are not worth putting on the public surface. -->
    <InternalsVisibleTo Include="SignUniversal.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="OpenMcdf" />
  </ItemGroup>

  <!--
    Namespaces this project uses nearly everywhere, declared once instead of at the
    top of every file. Kept to those referenced in more than a handful of files;
    single-file usages stay local.
  -->
  <ItemGroup>
    <Using Include="System.Formats.Asn1" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Security.Cryptography.X509Certificates" />
    <Using Include="SignUniversal.Signing" />
  </ItemGroup>

</Project>
