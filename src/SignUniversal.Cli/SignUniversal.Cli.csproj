<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SignUniversal.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sign-universal</ToolCommandName>
    <PackageId>SignUniversal.Cli</PackageId>
    <Description>Cross-platform Authenticode signing CLI (PE + MSI), keys in Azure Key Vault / Trusted Signing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignUniversal.Core\SignUniversal.Core.csproj" />
  </ItemGroup>

</Project>
