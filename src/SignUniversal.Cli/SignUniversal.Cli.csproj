<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SignUniversal.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sign-universal</ToolCommandName>
    <!-- The tool is the only thing that ships, so no .Cli suffix: there is no library
         beside it to distinguish it from. -->
    <PackageId>SignUniversal</PackageId>
    <Title>sign-universal</Title>
    <Description>Cross-platform code signing from Linux, macOS, or Windows with the private key held in Azure Trusted Signing, where it never leaves the HSM. Author-signs NuGet packages and Authenticode-signs Windows PE binaries. Fills the gap between `dotnet sign`, which supports Trusted Signing but only runs on Windows, and `dotnet nuget sign`, which runs anywhere but requires a local private key.</Description>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>signing;code-signing;authenticode;nuget;trusted-signing;azure;cross-platform;linux;ci</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignUniversal.Core\SignUniversal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Namespaces this project uses nearly everywhere, declared once instead of at the
    top of every file. Kept to those referenced in more than a handful of files;
    single-file usages stay local.
  -->
  <ItemGroup>
    <Using Include="System.Security.Cryptography" />
    <Using Include="SignUniversal.Core.Signing" />
  </ItemGroup>

</Project>
