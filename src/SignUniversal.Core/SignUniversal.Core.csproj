<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>SignUniversal.Core</RootNamespace>
    <Description>Cross-platform Authenticode signing engine (PE + MSI), keys held in Azure Key Vault / Trusted Signing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- So tests can reach helpers that are not worth putting on the public surface. -->
    <InternalsVisibleTo Include="SignUniversal.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Developer.TrustedSigning.CryptoProvider" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" />
    <PackageReference Include="OpenMcdf" />
  </ItemGroup>

  <!--
    Namespaces this project uses nearly everywhere, declared once instead of at the
    top of every file. Kept to those referenced in more than a handful of files;
    single-file usages stay local.
  -->
  <ItemGroup>
    <Using Include="System.Formats.Asn1" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Security.Cryptography.X509Certificates" />
    <Using Include="SignUniversal.Core.Signing" />
  </ItemGroup>

</Project>
