<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SignUniversal.Signing.Azure</RootNamespace>
    <Description>Azure key sources for sign-universal: IRemoteSigner implementations backed by Azure Trusted Signing and Azure Key Vault, authenticating through DefaultAzureCredential.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SignUniversal.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignUniversal\SignUniversal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Developer.TrustedSigning.CryptoProvider" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Security.Cryptography.X509Certificates" />
    <Using Include="SignUniversal.Signing" />
  </ItemGroup>

</Project>
